NODE_ENV=development
PORT=4000
TRUST_PROXY=0
MONGODB_URI=
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=
COOKIE_SECURE=false

# Optional Cloudinary signed uploads. Keep the API secret server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Optional HTTPS webhook for inquiry notifications.
INQUIRY_WEBHOOK_URL=

# Set only for the one-time owner bootstrap command; clear after provisioning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
